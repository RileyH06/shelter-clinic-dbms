<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Hyperlink?>

<AnchorPane xmlns="http://javafx.com"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.shelterclinic.HomePageController"
            prefHeight="400.0" prefWidth="600.0">
            <VBox spacing="10" alignment="CENTER"       AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                <Button text="login" onAction="#openLogin"/>
                <Label fx:id="shelterNameLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label text="showing animal catalog..."/>
            </VBox>
</AnchorPane>
