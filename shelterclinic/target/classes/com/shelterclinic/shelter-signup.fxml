<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Hyperlink?>

<AnchorPane xmlns="http://javafx.com"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.shelterclinic.ShelterSignupController"
            prefHeight="400.0" prefWidth="600.0">
            <VBox spacing="10" alignment="CENTER"       AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                
                <Label text="Shelter Registration" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

                <Label text="Shelter name:" labelFor="$nameField" />
                <TextField fx:id="nameField" maxWidth="240"/>

                <Label text="Shelter capacity:" labelFor="$capacityField" />
                <TextField fx:id="capacityField" maxWidth="240"/>

                <Label text="Password" labelFor="$passwordField"/>
                <PasswordField fx:id="passwordField" maxWidth="240"/>


                <Label fx:id="statusLabel"/>

                <Button text="Register" onAction="#CreateShelter"/>
                <Hyperlink text="Already registered? Login here" onAction="#openShelterLogin"/>
                <Hyperlink text="Login as user" onAction="#openLogin"/>
            </VBox>
</AnchorPane>