<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Hyperlink?>

<AnchorPane xmlns="http://javafx.com"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.shelterclinic.LoginController"
            prefHeight="400.0" prefWidth="600.0">
            <VBox spacing="10" alignment="CENTER"       AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                
                <Label text="Login" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

                <Label text="Email" labelFor="$emailField" />
                <TextField fx:id="emailField" maxWidth="240"/>

                <Label text="Password" labelFor="$passwordField"/>
                <PasswordField fx:id="passwordField" maxWidth="240"/>
                <Label fx:id="statusLabel"/>

                <Button text="Login" onAction="#validateUser"/>
                <Hyperlink text="Don't have an account? Sign up here" onAction="#openSignup"/>
                <Hyperlink text="Login as shelter" onAction="#openShelterLogin"/>
            </VBox>
</AnchorPane>
